# PostgreSQL
# Docker Compose maps Postgres to host port 55432 (avoids local Windows PG on 5432/5433)
DATABASE_URL=postgresql://lms:lms@localhost:55432/lms?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NODE_ENV=development
WEB_PUBLIC_URL=http://localhost:3000

# Auth (secrets must be >= 32 chars; never ship defaults to staging/prod)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Storage
# development: local | minio
# staging/production: STORAGE_DRIVER=minio REQUIRED with non-default credentials
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=../../storage/uploads
# Max upload size enforced in API: 10MB (streaming multipart to MinIO is a follow-up)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lms-content
MINIO_USE_SSL=false

# SMTP (Mailhog in docker-compose: SMTP 1025, UI http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Mahbere Ahaw LMS <noreply@mahbereahaw.org>

# Web Push VAPID (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mahbereahaw.org

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
