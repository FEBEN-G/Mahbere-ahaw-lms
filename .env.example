# PostgreSQL
# Docker Compose maps Postgres to host port 55432 (avoids local Windows PG on 5432/5433)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NODE_ENV=development
WEB_PUBLIC_URL=http://localhost:3000

# Auth (secrets must be >= 32 chars; never ship defaults to staging/prod)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Storage
# local: dev + Render production (attach Persistent Disk — see README)
# minio: optional later (R2/S3-compatible object storage)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=../../storage/uploads
# Render production example:
# STORAGE_DRIVER=local
# STORAGE_LOCAL_PATH=/data/uploads
# Max upload size enforced in API: 10MB
# MINIO_* only required when STORAGE_DRIVER=minio (optional local dev via docker-compose)
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=lms-content
# MINIO_USE_SSL=false

# SMTP (Mailhog in docker-compose: SMTP 1025, UI http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Mahbere Ahaw LMS <noreply@mahbereahaw.org>

# Web Push VAPID (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mahbereahaw.org

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Seed accounts (used by `npm run prisma:seed -w @lms/api`)
# Copy into apps/api/.env and replace placeholders. Never commit real values.
SEED_SUPER_ADMIN_EMAIL=admin@mahbereahaw.org
SEED_SUPER_ADMIN_PASSWORD=replace-with-strong-local-admin-password
SEED_INSTRUCTOR_EMAIL=instructor@mahbereahaw.org
SEED_INSTRUCTOR_PASSWORD=replace-with-strong-local-instructor-password
SEED_STUDENT_EMAIL=student@mahbereahaw.org
SEED_STUDENT_PASSWORD=replace-with-strong-local-student-password
